# OpenAI API — Required
OPENAI_API_KEY=your-openai-api-key

# Models (optional — defaults shown)
DIALOGUE_MODEL=gpt-4o-mini
DECISION_MODEL=gpt-4o-mini
ODDSMAKER_MODEL=gpt-4o-mini

# Server (optional)
HOST=0.0.0.0
PORT=8080

# Game (optional)
BETTING_WINDOW_SECONDS=30
STARTING_CHIPS=1000

# Database (optional)
DB_PATH=data/mafia-ai.db

# Logging (optional)
LOG_LEVEL=INFO

# Blockchain — On-chain betting (optional, set blockchain_enabled=True to activate)
BLOCKCHAIN_ENABLED=false
BLOCKCHAIN_RPC_URL=https://testnet-rpc.monad.xyz
BLOCKCHAIN_CHAIN_ID=10143
BLOCKCHAIN_PRIVATE_KEY=0xyour-private-key
BLOCKCHAIN_CONTRACT_ADDRESS=0xyour-deployed-contract-address

# Hardhat deployment (Node.js side)
PRIVATE_KEY=0xyour-deployer-private-key
