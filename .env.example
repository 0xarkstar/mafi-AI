# MafiaAI Environment Variables
# Copy this file to .env and fill in your values

# ============================================================
# OpenAI API (required for AI agents)
# ============================================================
OPENAI_API_KEY=your-openai-api-key

# ============================================================
# AI Models (optional — defaults shown)
# ============================================================
DIALOGUE_MODEL=gpt-4o-mini
DECISION_MODEL=gpt-4o-mini
ODDSMAKER_MODEL=gpt-4o-mini

# ============================================================
# Server (optional — defaults shown)
# ============================================================
HOST=0.0.0.0
PORT=8080

# ============================================================
# Game Settings (optional — defaults shown)
# ============================================================
BETTING_WINDOW_SECONDS=30

# ============================================================
# Lobby & Players (optional — defaults shown)
# ============================================================
LOBBY_TIMEOUT_SECONDS=300
HUMAN_TURN_TIMEOUT=60
MOLTBOOK_API_URL=https://api.moltbook.io

# Moltbook Identity Authentication (optional)
MOLTBOOK_APP_KEY=
MOLTBOOK_AUDIENCE=mafia-ai.example.com

# ============================================================
# Database (optional — default shown)
# ============================================================
DB_PATH=data/mafia-ai.db

# ============================================================
# Logging (optional — default shown)
# ============================================================
LOG_LEVEL=INFO

# ============================================================
# Blockchain / On-Chain Betting (optional — disabled by default)
# ============================================================
BLOCKCHAIN_ENABLED=false
BLOCKCHAIN_RPC_URL=https://testnet-rpc.monad.xyz
BLOCKCHAIN_CHAIN_ID=10143
BLOCKCHAIN_PRIVATE_KEY=0xyour-private-key
BLOCKCHAIN_CONTRACT_ADDRESS=0xyour-deployed-contract-address

# ============================================================
# X402 Open Betting Protocol (optional — disabled by default)
# ============================================================
X402_ENABLED=false
X402_FACILITATOR_URL=https://x402-facilitator.molandak.org
X402_NETWORK=eip155:10143
X402_USDC_ADDRESS=0x534b2f3A21130d7a60830c2Df862319e593943A3
X402_PAY_TO=0xyour-server-wallet-address

# ============================================================
# AI Bettor — Autonomous Betting Agent (optional — disabled by default)
# ============================================================
AI_BETTOR_ENABLED=false
AI_BETTOR_PRIVATE_KEY=0xyour-ai-bettor-private-key
AI_BETTOR_BUDGET_USDC=50.0

# ============================================================
# USDC Settlement (optional — disabled by default)
# ============================================================
SETTLEMENT_ENABLED=false
SETTLEMENT_PRIVATE_KEY=0xyour-settlement-private-key

# Privy Wallet Auth (optional - for real wallet connections)
VITE_PRIVY_APP_ID=your-privy-app-id