{
  "name": "mafia-betting-contracts",
  "version": "1.0.0",
  "description": "MafiaBetting smart contract for Monad testnet",
  "scripts": {
    "compile": "npx hardhat compile",
    "test": "npx hardhat test",
    "deploy:testnet": "npx hardhat run scripts/deploy.js --network monadTestnet",
    "deploy:local": "npx hardhat run scripts/deploy.js --network hardhat",
    "deploy-v2:testnet": "npx hardhat run scripts/deploy-v2.js --network monadTestnet",
    "deploy-v2:local": "npx hardhat run scripts/deploy-v2.js --network hardhat",
    "deploy-v2:bsc-testnet": "npx hardhat run scripts/deploy-v2-bsc.js --network bscTestnet"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@openzeppelin/contracts": "^5.0.0",
    "dotenv": "^16.4.0",
    "hardhat": "^2.22.0"
  }
}
